<% layout("/layout/boilerplate.ejs") %>

<h2 class="mb-4">My Trips</h2>

<% if (bookings.length === 0) { %>
    <p>You have no trips yet.</p>
<% } %>

<% bookings.forEach(booking => { %>
    <div class="card mb-3">
        <div class="card-body">

            <h5><%= booking.listing.title %></h5>

            <p>
                <%= booking.checkIn.toDateString() %>
                →
                <%= booking.checkOut.toDateString() %>
            </p>

            <p>
                ₹ <%= booking.totalPrice.toLocaleString("en-IN") %>
            </p>

            <!-- STATUS -->
            <% if (booking.status === "cancelled") { %>
                <span class="badge bg-danger">Cancelled</span>
            <% } else { %>
                <span class="badge bg-success">Confirmed</span>
            <% } %>

            <!-- CANCEL BUTTON (ONLY IF ACTIVE) -->
            <% if (booking.status !== "cancelled") { %>
                <form
                    action="/bookings/<%= booking._id %>?_method=DELETE"
                    method="POST"
                    class="mt-3">
                    <button class="btn btn-outline-danger btn-sm">
                        Cancel Booking
                    </button>
                </form>
            <% } %>
            
            <a 
                href="https://www.google.com/maps/dir/?api=1&destination=<%= listing.geometry.coordinates[1] %>,<%= listing.geometry.coordinates[0] %>" 
                target="_blank"
                class="btn btn-success"
                >
                <button>Get Directions</button>
            </a>

        </div>
    </div>
<% }) %>
