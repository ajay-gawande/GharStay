<% layout("/layout/boilerplate.ejs") %>

<h2 class="mb-4">Bookings on Your Listings</h2>

<% if (bookings.length === 0) { %>
    <p>No bookings yet.</p>
<% } %>

<% bookings.forEach(booking => { %>
    <div class="card mb-3">
        <div class="card-body">

            <h5><%= booking.listing.title %></h5>

            <p>
                <strong>Guest:</strong> <%= booking.guest.username %>
            </p>

            <p>
                <strong>Stay:</strong>
                <%= booking.checkIn.toDateString() %>
                →
                <%= booking.checkOut.toDateString() %>
            </p>

            <p>
                <strong>Total:</strong>
                ₹ <%= booking.totalPrice.toLocaleString("en-IN") %>
            </p>

            <!-- STATUS -->
            <% if (booking.status === "cancelled") { %>
                <span class="badge bg-danger">Cancelled</span>
            <% } else { %>
                <span class="badge bg-success">Confirmed</span>
            <% } %>

            <!-- HOST CAN CANCEL ANY ACTIVE BOOKING -->
            <% if (booking.status !== "cancelled") { %>
                <form
                    action="/bookings/<%= booking._id %>?_method=DELETE"
                    method="POST"
                    class="mt-3">
                    <button class="btn btn-outline-danger btn-sm">
                        Cancel Booking
                    </button>
                </form>
            <% } %>

        </div>
    </div>
<% }) %>
