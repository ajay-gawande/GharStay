
<% layout("/layout/boilerplate.ejs") %>

<script>
    const mapToken = "<%= process.env.MAPBOX_TOKEN %>";
</script>


<div class="row">
    <div class="col-8 offset-2">
        <br>

        <h3>Add New Listing</h3>

        <form
            method="POST"
            action="/listing"
            class="needs-validation"
            novalidate
            enctype="multipart/form-data">

            <!-- TITLE -->
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input
                    name="listing[title]"
                    type="text"
                    class="form-control"
                    placeholder="Enter title"
                    required>
                <div class="invalid-feedback">
                    Please enter a title.
                </div>
            </div>

            <!-- IMAGE UPLOAD -->
            <div class="mb-3">
                <label class="form-label">Upload Image</label>
                <input
                    name="listing[image]"
                    type="file"
                    class="form-control"
                    required>
                <div class="invalid-feedback">
                    Please upload an image.
                </div>
            </div>

            <!-- DESCRIPTION -->
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea
                    name="listing[description]"
                    class="form-control"
                    required></textarea>
                <div class="invalid-feedback">
                    Please enter a description.
                </div>
            </div>

            <!-- PRICE + COUNTRY -->
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label class="form-label">Price</label>
                    <input
                        name="listing[price]"
                        type="number"
                        class="form-control"
                        placeholder="1200"
                        min="0"
                        required>
                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                </div>

                <div class="mb-3 col-md-8">
                    <label class="form-label">Country</label>
                    <input
                        name="listing[country]"
                        type="text"
                        class="form-control"
                        placeholder="India"
                        required>
                    <div class="invalid-feedback">
                        Please enter a country.
                    </div>
                </div>
            </d iv>

            <!-- LOCATION -->
            <div class="mb-3">
                <label class="form-label">Location</label>
                <input
                    name="listing[location]"
                    type="text"
                    class="form-control"
                    placeholder="Mumbai, Chembur"
                    required>
                <div class="invalid-feedback">
                    Please enter a location.
                </div>
            </div>
            <button type="button" id="getLocation" class="btn btn-outline-primary">
                Use My Current Location
            </button>

            <div id="map" style="height: 300px; margin-top: 10px;"></div>

            <!-- REQUIRED for GeoJSON -->
            <input type="hidden" name="listing[geometry][type]" value="Point">

            <!-- coordinates: [lng, lat] -->
            <input type="hidden" id="lng" name="listing[geometry][coordinates][0]">
            <input type="hidden" id="lat" name="listing[geometry][coordinates][1]">



            <!-- SUBMIT -->
            <button class="btn add-btn">Add Listing</button>
        </form>
    </div>
</div>
<script src="/js/locationMap.js"></script>