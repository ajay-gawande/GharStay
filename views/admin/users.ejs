<% layout("/layout/boilerplate.ejs") %>

<div class="container mt-4">
  <h2 class="mb-4">All Users</h2>

  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <th>Username</th>
        <th>Email</th>
        <th>Role</th>
        <th>Joined</th>
      </tr>
    </thead>

    <tbody>
      <% users.forEach(user => { %>
        <tr>
          <td><%= user.username %></td>
          <td><%= user.email %></td>
          <td>
            <span class="badge bg-dark">
              <%= user.role %>
            </span>
          </td>
          <td>
            <%= user.createdAt.toDateString() %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
